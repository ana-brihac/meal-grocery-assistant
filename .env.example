# Copy to .env in this same directory and fill in real values. .env is
# gitignored; this file is committed so the required shape is documented.
#
# docker-compose reads .env automatically for variable substitution, and the
# java-backend container receives these as environment variables.

# Gemini API key. Used for receipt OCR, shelf price-tag OCR, and the last-resort
# per-100g nutrition estimate when USDA has no match.
OCR_API_KEY=your_gemini_api_key_here

# USDA FoodData Central API key. Get one free at
# https://fdc.nal.usda.gov/api-key-signup, or use DEMO_KEY for light manual
# testing (shared, ~30 requests/hour).
USDA_API_KEY=your_usda_api_key_here
